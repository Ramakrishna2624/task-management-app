# ===========================
# Server Configuration
# ===========================
PORT=5000
NODE_ENV=development

# ===========================
# Database
# ===========================
# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/task-management
# OR MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/task-management

# ===========================
# Authentication (JWT)
# ===========================
# IMPORTANT: Use a strong random secret in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ===========================
# CORS
# ===========================
# Set to your deployed frontend URL in production
FRONTEND_URL=http://localhost:3000

# ===========================
# Cloudinary (File Upload)
# ===========================
# Get credentials from: https://cloudinary.com → Dashboard
# Leave empty to use fallback mode (returns demo URL)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===========================
# Email (Resend)
# ===========================
# Get API key from: https://resend.com → API Keys
# Leave empty to use log fallback (emails printed to console)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=TaskFlow <no-reply@yourdomain.com>

# ===========================
# OpenWeatherMap
# ===========================
# Get API key from: https://openweathermap.org/api
# Leave empty to use mock weather data (22°C, clear sky)
OPENWEATHER_API_KEY=your_openweathermap_api_key
