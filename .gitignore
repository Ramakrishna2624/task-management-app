# ===============================
# Dependencies
# ===============================
node_modules/

# ===============================
# Environment Variables — NEVER COMMIT
# ===============================
.env
.env.local
.env.production
.env.development
.env.staging

# ===============================
# Build Output
# ===============================
# Allow backend/dist to be deployed (Render uses pre-built dist)
frontend/.next/
frontend/out/
frontend/build/
# Exclude only frontend dist if it exists
frontend/dist/

# ===============================
# Test Coverage
# ===============================
coverage/
.nyc_output/

# ===============================
# Logs
# ===============================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===============================
# Runtime / Cache
# ===============================
.cache/
.temp/
tmp/
*.tsbuildinfo
tsconfig.tsbuildinfo

# ===============================
# OS / Editor Files
# ===============================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ===============================
# Miscellaneous
# ===============================
*.pem
*.key
*.cert
